@model ABCRetailWebApp.Models.OrderMessageModel

@{
    ViewData["Title"] = "ABC Retail - Order Queue Terminal";
    // ✅ Updated to point to CustomQueueMessage to match the controller file
    var messageStack = ViewBag.QueueMessages as List<ABCRetailWebApp.Controllers.CustomQueueMessage> ?? new List<ABCRetailWebApp.Controllers.CustomQueueMessage>();
}

<div class="container mt-5">
    <div class="row">
        <!-- LEFT COLUMN: Messaging Injection Box Form -->
        <div class="col-lg-4 mb-4">
            <div class="card shadow border-0">
                <div class="card-header bg-warning text-dark py-3">
                    <h5 class="mb-0">📦 Send Order Processing Message</h5>
                </div>
                <div class="card-body p-4">
                    @if (ViewBag.Message != null)
                    {
                        <div class="alert alert-success">@ViewBag.Message</div>
                    }
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">@ViewBag.Error</div>
                    }

                    <form asp-controller="Order" asp-action="Send" method="post">
                        <div class="mb-3">
                            <label asp-for="Content" class="form-label font-weight-bold">Order Details / Message Payload</label>
                            <textarea asp-for="Content" class="form-control" rows="5" placeholder="e.g. { 'orderId': 1001, 'product': 'Laptop', 'quantity': 1 }"></textarea>
                            <span asp-validation-for="Content" class="text-danger"></span>
                        </div>
                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-warning btn-lg text-dark font-weight-bold">Enqueue Order Message</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN: Live Order Fulfillment Stream -->
        <div class="col-lg-8">
            <h3 class="mb-4 text-secondary">⚙️ Live Order Fulfillment Stream</h3>

            @if (!messageStack.Any())
            {
                <div class="alert alert-light border py-4 text-center shadow-sm text-muted">
                    <h5>All queues cleared! No active messages found.</h5>
                    <p class="mb-0 small">Incoming order streams will manifest automatically as transactions are posted.</p>
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var msg in messageStack)
                    {
                        <div class="col-12">
                            <div class="card shadow-sm border-start border-warning border-4">
                                <div class="card-body d-flex justify-content-between align-items-center p-3">
                                    <div class="text-truncate me-3">
                                        <span class="badge bg-dark mb-2 font-monospace small">ID: @msg.MessageId.Substring(0, Math.Min(8, msg.MessageId.Length))...</span>
                                        <div class="text-dark font-monospace text-wrap bg-light p-2 rounded border small">
                                            @msg.BodyText
                                        </div>
                                    </div>
                                    <div>
                                        <form asp-controller="Order" asp-action="ProcessMessage" method="post" class="mb-0">
                                            <input type="hidden" name="messageId" value="@msg.MessageId" />
                                            <button type="submit" class="btn btn-success btn-sm font-weight-bold text-nowrap py-2 px-3 shadow-sm">
                                                ✅ Process Task
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
