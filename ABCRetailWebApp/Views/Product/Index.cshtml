@model ABCRetailWebApp.Models.ProductViewModel

@{
    ViewData["Title"] = "ABC Retail - Product Catalog Management";
    var productList = ViewBag.Products as List<ABCRetailWebApp.Models.ProductViewModel> ?? new List<ABCRetailWebApp.Models.ProductViewModel>();
}

<div class="container mt-5">
    <div class="row">
        <!-- LEFT COLUMN: Management Upload Control Form Form -->
        <div class="col-lg-4 mb-4">
            <div class="card shadow border-0">
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="mb-0">Add New Store Merchandise</h5>
                </div>
                <div class="card-body p-4">
                    @if (ViewBag.Message != null)
                    {
                        <div class="alert alert-success">@ViewBag.Message</div>
                    }
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">@ViewBag.Error</div>
                    }

                    <form asp-controller="Product" asp-action="AddProduct" method="post" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label asp-for="ProductName" class="form-label font-weight-bold"></label>
                            <input asp-for="ProductName" class="form-control" placeholder="e.g. Leather Jacket" />
                            <span asp-validation-for="ProductName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Price" class="form-label font-weight-bold"></label>
                            <div class="input-group">
                                <span class="input-group-text">R</span>
                                <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Category" class="form-label font-weight-bold">Department Category</label>
                            <select asp-for="Category" class="form-select">
                                <option value="">-- Choose Category --</option>
                                <option value="Electronics">Electronics</option>
                                <option value="Clothing">Apparel & Clothing</option>
                                <option value="Home">Home Appliances</option>
                                <option value="Footwear">Footwear</option>
                            </select>
                            <span asp-validation-for="Category" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ProductImageFile" class="form-label font-weight-bold"></label>
                            <input asp-for="ProductImageFile" type="file" class="form-control" accept="image/*" />
                            <span asp-validation-for="ProductImageFile" class="text-danger"></span>
                        </div>

                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">Publish to Live Storefront</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN: Real-Time Dynamic E-Commerce Storefront Grid Layout Grid -->
        <div class="col-lg-8">
            <h3 class="mb-4 text-secondary">Live Active Product Inventory</h3>

            @if (!productList.Any())
            {
                <div class="alert alert-info py-4 shadow-sm text-center">
                    <h5>No active products cataloged yet!</h5>
                    <p class="text-muted mb-0">Use the creation form on the left to upload your very first cloud asset store listing.</p>
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-md-2 g-4">
                    @foreach (var item in productList)
                    {
                        <div class="col">
                            <div class="card h-100 shadow-sm border-0 position-relative">
                                <span class="position-absolute top-0 start-0 m-2 badge bg-secondary">@item.Category</span>
                                <div class="text-center bg-light p-3" style="height: 180px; display: flex; align-items: center; justify-content: center;">
                                    @if (!string.IsNullOrEmpty(item.FinalImageUrl))
                                    {
                                        <img src="@item.FinalImageUrl" class="img-fluid rounded" alt="@item.ProductName" style="max-height: 100%; object-fit: contain;" />
                                    }
                                    else
                                    {
                                        <div class="text-muted">No Image Resource Provided</div>
                                    }
                                </div>
                                <div class="card-body d-flex flex-column justify-content-between">
                                    <h5 class="card-title text-truncate font-weight-bold">@item.ProductName</h5>
                                    <div class="d-flex justify-content-between align-items-center mt-2">
                                        <span class="h4 text-success mb-0">R @item.Price.ToString("F2")</span>
                                        <button class="btn btn-outline-dark btn-sm rounded-pill px-3">View Item Details</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
